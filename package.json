{
  "name": "day16",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run wrangler -- dev",
    "build": "tsc && rm -rf dist && mkdir -p dist/seasoned && cp index.html sample-page.jpg dist/seasoned/",
    "test": "vitest run",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "deploy": "npm run build && npm run wrangler -- deploy",
    "plan": "node recipes/plan.js",
    "generate": "node --env-file-if-exists=.env recipes/generate.js",
    "check": "node recipes/check.js",
    "judge": "node --env-file-if-exists=.env recipes/judge.js",
    "planted": "node --env-file-if-exists=.env recipes/planted.js",
    "pages": "node pages/build.ts",
    "pages:book": "node pages/build.ts --in recipes/out/book/recipes --out pages/out/book --pictures pictures/seasoned",
    "book": "node book/build.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
